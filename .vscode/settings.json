{
  // ⚠️ DO NOT ADD `python.defaultInterpreterPath` HERE. It looks like the
  // obvious thing to set, and it breaks the dev container.
  //
  // VS Code resolves WORKSPACE settings above REMOTE ones, so a value in this
  // file overrides .devcontainer/devcontainer.json rather than deferring to it.
  // A path like "${workspaceFolder}/.venv/bin/python" then follows you into the
  // container, where ${workspaceFolder} is /app and /app/.venv is deliberately
  // masked to an empty directory (the host venv holds macOS-native wheels that
  // are wrong for Linux). The result is an "interpreter does not exist" error
  // and no import resolution — the exact problem the venv exists to solve.
  //
  // With it absent, both cases work: the Python extension auto-discovers
  // .venv/ in the workspace root locally, and the dev container's own setting
  // finally applies inside the container. See issue #78.

  // The app is imported as `app`, and tests as `tests.*`, both from the repo
  // root — mirroring pytest.ini's `pythonpath = .`.
  "python.analysis.extraPaths": ["${workspaceFolder}"],

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Ruff is the project's only linter and the formatter is deliberately NOT
  // adopted — enabling format-on-save would rewrite ~6,400 lines across 64
  // files and destroy git blame. See the note in pyproject.toml.
  "editor.formatOnSave": false,

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
