{
  // Interpreter for when the repository is opened NORMALLY (not attached to the
  // dev container). Points at the local .venv, which exists purely so the
  // language server can resolve flask/psycopg2/pytest — nothing is ever run
  // from it. See CONTRIBUTING.md §1.
  //
  // When attached to the dev container, .devcontainer/devcontainer.json
  // overrides this with the container's own interpreter, which is the same
  // Python 3.11 the image ships.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // The app is imported as `app`, and tests as `tests.*`, both from the repo
  // root — mirroring pytest.ini's `pythonpath = .`.
  "python.analysis.extraPaths": ["${workspaceFolder}"],

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Ruff is the project's only linter and the formatter is deliberately NOT
  // adopted — enabling format-on-save would rewrite ~6,400 lines across 64
  // files and destroy git blame. See the note in pyproject.toml.
  "editor.formatOnSave": false,

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
