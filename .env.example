# Budget Buddy — environment template.
#
#   cp .env.example .env      then fill in the values below.
#
# Docker Compose reads this file for BOTH the app (env_file:) and the Postgres
# container (POSTGRES_USER/PASSWORD/DB are interpolated from DB_*), so the DB_*
# values here are what the database is CREATED with on first boot.
#
# Never commit .env — it is gitignored.


# ─── Database (required) ──────────────────────────────────────────────────────
# DB_HOST is the compose service name, not localhost — the app talks to Postgres
# over the compose network.
DB_HOST=db
DB_PORT=5432
DB_NAME=budget
DB_USER=admin
DB_PASSWORD=change-me

# ─── Least-privilege application role (optional, recommended) ─────────────────
# DB_USER above is the database OWNER — compose creates the cluster with it, so
# it is a superuser. Leaving the app connected as that means any SQL injection
# or code execution inherits superuser: DROP anything, read every database,
# or run shell commands via COPY ... FROM PROGRAM.
#
# sql/30_app_role.sql creates a `budget_app` role with SELECT/INSERT/UPDATE/
# DELETE and nothing else. Point the app at it here. DB_USER stays as it is —
# migrations and pg_dump still need the owner.
#
# Unset, the app falls back to DB_USER and behaves exactly as before, so this
# is safe to leave blank until you have run the migration.
DB_APP_USER=
DB_APP_PASSWORD=


# ─── Flask (required) ─────────────────────────────────────────────────────────
# Signs session cookies and CSRF tokens. The app REFUSES TO BOOT without it
# (see app/__init__.py) rather than 500ing confusingly on the first request.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every existing session.
SECRET_KEY=


# ─── AI features (optional) ───────────────────────────────────────────────────
# Gates all nine AI surfaces via ai_enabled(). Leave BLANK for local dev — every
# AI card self-disables cleanly and the full test suite still passes (tests stub
# the model seams, so they never make a real call either way).
ANTHROPIC_API_KEY=


# ─── Email / weekly digest (optional) ─────────────────────────────────────────
# Gates outbound email via mail_enabled(). Leave BLANK locally.
RESEND_API_KEY=
# Sender identity. Has a built-in default; override only if you own the domain.
# DIGEST_FROM=Budget Buddy <noreply@example.com>
# DIGEST_REPLY_TO=you@example.com


# ─── Bill-due push reminders (optional) ───────────────────────────────────────
# Gates Web Push via push_enabled(). Leave BLANK locally — the opt-in UI hides
# itself and the daily job simply skips its reminder half.
#
# Generate a keypair (needs the app image, which has `cryptography`):
#   docker compose run --rm --no-deps --entrypoint python web -c "
#   import base64
#   from cryptography.hazmat.primitives.asymmetric import ec
#   from cryptography.hazmat.primitives import serialization
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   k = ec.generate_private_key(ec.SECP256R1())
#   print('VAPID_PUBLIC_KEY=' + b64(k.public_key().public_bytes(
#       serialization.Encoding.X962,
#       serialization.PublicFormat.UncompressedPoint)))
#   print('VAPID_PRIVATE_KEY=' + b64(
#       k.private_numbers().private_value.to_bytes(32, 'big')))"
#
# ⚠️ Changing these invalidates every existing subscription — every device has
# to opt in again, silently (the browser just stops accepting your pushes).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL the push provider can use to reach you about a misbehaving sender.
# Part of the VAPID spec, not optional. Has a built-in default.
# VAPID_SUBJECT=mailto:you@example.com


# ─── Production-only switches ─────────────────────────────────────────────────
# ⚠️ BOTH MUST STAY UNSET LOCALLY AND IN CI.
#
# ENABLE_DIGEST_SCHEDULER=1 starts the APScheduler jobs — the weekly digest
#   email AND the daily pass that materializes due schedules and sends bill
#   reminders. Set it locally and your dev box starts writing real transactions
#   (and sending real email, if a Resend key is set). It is only safe under
#   SINGLE-WORKER gunicorn — with multiple workers every job runs once per
#   worker.
# COOKIE_SECURE=1 turns on Secure cookies + HSTS. Set it locally and you cannot
#   log in over plain http:// — the browser refuses to send the session cookie.
#
# ENABLE_DIGEST_SCHEDULER=1
# COOKIE_SECURE=1
