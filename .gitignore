# Secrets — never commit. .env.example is the tracked template.
.env
*.env

# Bitwarden .env rebuild shim + its rollback copy. Both listed EXPLICITLY:
# `*.env` matches files ENDING in .env, so it catches neither `bw-env.sh` nor
# `.env.bak`. The .bak holds real secrets — without this line it is committable.
bw-env.sh
bw-seed.sh
.env.bak*

# Local-only Claude Code context: Droplet IP, vault paths, personal cadence.
# CLAUDE.md itself IS tracked — it is the project's onboarding doc.
CLAUDE.local.md

# Real financial data — pg_dump output. Never commit.
backups/
*.dump
*.sql.gz

# Python. `.venv/` is the editor's interpreter — it exists so the language
# server can resolve flask/psycopg2/pytest, NOT to run anything. The app and the
# test suite still run in containers. Both spellings, since only `venv/` was
# listed and the tooling default is `.venv/`.
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# macOS. Note the capital S — git patterns are case-sensitive and the file
# Finder actually creates is ".DS_Store".
.DS_Store

# Scratch data for the scripts/ ingest pipeline
data/*.csv
